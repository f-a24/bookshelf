---
import BaseHead from '../components/BaseHead.astro';
import BookFilter from '../components/BookFilter.astro';
import Bookshelf from '../components/Bookshelf.astro';
import Footer from '../components/Footer.astro';
import LibraryRoom from '../components/LibraryRoom.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getBooksByPublishedDate } from '../lib/books';

// 全冊を発売日の新しい順に1ページに並べ、表示する本は BookFilter で絞り込む
const books = await getBooksByPublishedDate();
---

<!doctype html>
<html lang="ja">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <style>
      main {
        width: 960px;
      }
    </style>
  </head>
  <body>
    <LibraryRoom />
    <main id="main">
      <BookFilter books={books} />
      <Bookshelf books={books} heading="本棚" />
    </main>
    <Footer />
  </body>
</html>
