---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { STATUS_LABELS } from '../lib/books';
import BookModal from './BookModal.astro';

interface Props {
  books: CollectionEntry<'books'>[];
  /** 本棚の上部に表示する見出し */
  heading: string;
}

const { books, heading } = Astro.props;

/** 最初に画面に入る本の数（1段目。表紙は遅延読み込みしない） */
const FIRST_ROW = 5;

/**
 * 表紙の画像の幅の候補と、表示される幅。
 * 本の高さは 180px（本棚の幅が 640px 未満では 120px）で、表紙の縦横比は本によって
 * 1:1.2〜1:1.65 くらいなので、表示される幅は最大でおよそ 150px / 100px。
 * 画面の解像度に合わせてブラウザが候補から選ぶ
 */
const COVER_WIDTHS = [100, 150, 200, 300];
const COVER_SIZES = '(width < 690px) 100px, 150px';
---

<section class="bookcase" aria-labelledby="bookcase-heading">
  <!--
    見出しと冊数は、見た目には出さず読み上げソフトにだけ伝える
    （ページの見出しとして必要で、絞り込むと冊数が変わることも知らせたいため）
  -->
  <header class="sr-only">
    <h1 id="bookcase-heading">{heading}</h1>
    <p role="status">
      <span data-book-count>{books.length}</span>冊
    </p>
  </header>

  <!-- Safari は list-style: none のリストを一覧として読まないので role="list" を付ける -->
  <ul class="shelves" role="list">
    {books.map((book, index) => (
      <li
        data-status={book.data.status}
        data-categories={JSON.stringify(book.data.categories)}
      >
        {/* commandfor / command で、JS なしにモーダルを開く */}
        <button
          type="button"
          class="book"
          commandfor={`book-${book.id}`}
          command="show-modal"
          aria-haspopup="dialog"
        >
          {book.data.cover ? (
            <Image
              src={book.data.cover}
              alt={book.data.title}
              widths={COVER_WIDTHS}
              sizes={COVER_SIZES}
              quality={60}
              loading={index < FIRST_ROW ? 'eager' : 'lazy'}
              fetchpriority={index === 0 ? 'high' : undefined}
            />
          ) : (
            // 表紙がない本は、タイトルを書いた布張りの本として表示する
            <span class="no-cover">{book.data.title}</span>
          )}
          {/* 読了以外の本には、しおり風のラベルで状態を出す */}
          {book.data.status !== 'read' && (
            <span class={`badge badge-${book.data.status}`}>
              {STATUS_LABELS[book.data.status]}
            </span>
          )}
        </button>
      </li>
    ))}
  </ul>
  <p class="empty" data-book-empty hidden>
    条件に合う本はありません
  </p>
</section>

{books.map(book => (
  <BookModal book={book} />
))}

<script>
  // closedby="any"（背景クリックで閉じる）に未対応のブラウザ用の代わりの処理
  const supportsClosedBy = 'closedBy' in HTMLDialogElement.prototype;

  /** クリック位置がダイアログの外側（背景）かどうか */
  const isOutside = (dialog: HTMLDialogElement, event: MouseEvent) => {
    const rect = dialog.getBoundingClientRect();
    return (
      event.clientX < rect.left ||
      event.clientX > rect.right ||
      event.clientY < rect.top ||
      event.clientY > rect.bottom
    );
  };

  /** URL のハッシュを #book-xxx にして、開いた本をそのまま共有できるようにする */
  const setHash = (id: string) => history.replaceState(null, '', `#${id}`);
  const clearHash = () =>
    history.replaceState(null, '', location.pathname + location.search);

  for (const dialog of document.querySelectorAll<HTMLDialogElement>(
    'dialog.book-modal',
  )) {
    // command イベントは開く対象のダイアログ自身に届く（バブリングしない）
    dialog.addEventListener('command', event => {
      if ((event as Event & { command: string }).command === 'show-modal') {
        setHash(dialog.id);
      }
    });
    // Esc・閉じるボタン・背景クリックのどれで閉じても、ハッシュを消す
    dialog.addEventListener('close', clearHash);

    if (!supportsClosedBy) {
      dialog.addEventListener('click', event => {
        if (event.target === dialog && isOutside(dialog, event)) dialog.close();
      });
    }
  }

  // #book-xxx 付きの URL で来たときは、最初からモーダルを開く
  if (location.hash.startsWith('#book-')) {
    const dialog = document.getElementById(
      decodeURIComponent(location.hash.slice(1)),
    );
    if (dialog instanceof HTMLDialogElement) dialog.showModal();
  }
</script>

<style>
  .bookcase {
    /* 棚の大きさは、本棚自体の幅に合わせて切り替える（コンテナクエリ） */
    container-type: inline-size;
  }

  /* 棚：背板・棚板・棚板の影を1段分ずつ縦に繰り返す。木は背板と棚板の2色だけにして、表紙を目立たせる */
  .shelves {
    --row: 240px; /* 棚1段の高さ */
    --plank: 18px; /* 棚板の厚み */
    --book-h: 180px; /* 本の高さ */

    display: grid;
    /* 表紙の画像が列の幅を押し広げないよう、minmax(0, 1fr) にする */
    grid-template-columns: repeat(5, minmax(0, 1fr));
    grid-auto-rows: var(--row);
    margin: 0;
    padding: 0 1rem;
    list-style: none;
    border-radius: var(--radius-panel);
    background-color: var(--color-wood-back);
    background-image:
      /* 棚板 */
      linear-gradient(
        180deg,
        transparent calc(var(--row) - var(--plank)),
        var(--color-wood-plank) calc(var(--row) - var(--plank)),
        var(--color-wood-plank-edge) var(--row)
      ),
      /* 棚板の下に落ちる影 */
      linear-gradient(180deg, var(--color-plank-shadow), transparent 16px);
    background-size: 100% var(--row);

    & li:not([hidden]) {
      /* 表紙の高さの上限を、このマスの幅（100cqi）から決めるため */
      container-type: inline-size;
      display: flex;
      align-items: flex-end;
      justify-content: center;
      min-width: 0;
      padding-block-end: var(--plank);
    }
  }

  /* 絞り込みで1冊も残らなかったとき */
  .empty {
    margin: 0;
    padding: 3rem 1rem;
    border-radius: var(--radius-panel);
    background: var(--color-wood-back);
    color: var(--color-muted);
    text-align: center;
  }

  /* 本 */
  .book {
    position: relative;
    display: block;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: inherit;
    cursor: pointer;

    /* ホバー・フォーカス中は表紙を少し明るくする（動きを減らす設定でも分かるように） */
    &:is(:hover, :focus-visible) :is(img, .no-cover) {
      filter: brightness(1.08);
    }
    &:focus-visible {
      outline-offset: 4px;
      border-radius: var(--radius-book);
    }
  }

  /* 動きを減らす設定のときは、本を持ち上げる動きを付けない */
  @media (prefers-reduced-motion: no-preference) {
    .book {
      transition: transform var(--dur-short) var(--ease-out);

      &:is(:hover, :focus-visible) {
        transform: translateY(-6px);
      }
    }
  }

  .book img,
  .no-cover {
    display: block;
    border-radius: var(--radius-book);
    box-shadow: var(--shadow-book);
  }
  /*
    表紙は切り抜かず、本ごとの縦横比のまま出す。
    高さを決めておくと、幅は img の width / height 属性の比から決まるので、読み込む前から場所が確保される。
    高さは本の高さにそろえるが、いちばん横長の表紙（縦横比 1:1.21）でも棚の幅に収まるよう、
    棚1マスの幅（100cqi）でも上限をかける
  */
  .book img {
    width: auto;
    height: min(var(--book-h), (100cqi - 16px) * 1.21);
    /*
      幅の上限はマスの幅（100cqi）から決める。
      100% にすると、表紙の幅に合わせて縮むボタンの幅が基準になり、表紙が必ず 16px 細くなってしまう
    */
    max-width: calc(100cqi - 16px);
    /* これより横長の表紙が来ても、ゆがめずに収める */
    object-fit: contain;
  }
  /* 表紙がない本は、A判・B判に近い 1:1.414 の布張りにする */
  .no-cover {
    height: var(--book-h);
    aspect-ratio: 1 / 1.414;
    max-width: calc(100cqi - 16px);
    box-sizing: border-box;
    padding: 18% 12% 0 16%;
    overflow: clip;
    background: var(--cloth-cover);
    color: var(--color-cloth-ink);
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: bold;
    line-height: 1.5;
    text-align: start;
    word-break: break-all;
  }

  /* 状態ラベル（本の上端から垂れるしおり） */
  .badge {
    position: absolute;
    top: -6px;
    right: 14px;
    z-index: 1;
    padding: 6px 4px 11px;
    font-size: 0.6875rem;
    font-weight: bold;
    line-height: 1.1;
    color: var(--color-status-ink);
    writing-mode: vertical-rl;
    clip-path: polygon(0 0, 100% 0, 100% 100%, 50% calc(100% - 6px), 0 100%);
  }
  .badge-reading {
    background: var(--color-status-reading);
  }
  .badge-unread {
    background: var(--color-status-unread);
  }

  /* 本棚の幅が狭いとき（スマートフォンなど）は3列にする */
  @container (width < 640px) {
    .shelves {
      --row: 170px;
      --plank: 14px;
      --book-h: 120px;

      grid-template-columns: repeat(3, minmax(0, 1fr));
      padding: 0 0.25rem;
    }
  }
</style>
